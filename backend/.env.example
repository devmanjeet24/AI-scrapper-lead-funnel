DATABASE_URL=postgresql://user:password@host/db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=your_groq_api_key_here

# AI / Groq (post-scrape intelligence)
AI_ENABLED=true
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_INPUT_CHARS=6000
AI_MAX_SIGNALS_PER_PAGE=5

# Scraper / Playwright
SCRAPER_TIMEOUT_MS=30000
SCRAPER_NAVIGATION_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true
SCRAPER_WAIT_UNTIL=domcontentloaded
SCRAPER_VISIBLE_TEXT_MAX_CHARS=2000

# Optional ad platform credentials (Phase 5 — paid APIs, not required for prototype)
FACEBOOK_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
LINKEDIN_ADS_ACCESS_TOKEN=

# Outreach — Email (Resend). Free tier: 3,000/mo, 100/day.
# Get key: https://resend.com -> API Keys. Default from-address only delivers to your
# signup email until you verify a domain, then set RESEND_FROM_EMAIL=you@yourdomain.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO=

# Outreach — Voice (Retell / Vapi). Not yet wired (Phase 3).
RETELL_API_KEY=
VAPI_API_KEY=

# Google Calendar / OAuth (Phase 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google-calendar/callback
GOOGLE_CALENDAR_ID=primary
# GOOGLE_OAUTH_ENCRYPTION_KEY=  # optional; derives from SECRET_KEY if unset
APPOINTMENT_DEFAULT_DURATION_MINUTES=30
APPOINTMENT_SLOT_BUFFER_MINUTES=15
APPOINTMENT_BOOKING_HORIZON_DAYS=14
# SALES_TEAM_EMAIL=
# SALES_HANDOFF_WEBHOOK_URL=