DATABASE_URL=postgresql://user:password@host/db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=your_groq_api_key_here

# AI / Groq (post-scrape intelligence)
AI_ENABLED=true
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_MAX_REQUESTS_PER_MINUTE=30
AI_MAX_INPUT_CHARS=6000
AI_MAX_SIGNALS_PER_PAGE=5

# Scraper / Playwright
SCRAPER_TIMEOUT_MS=30000
SCRAPER_NAVIGATION_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true
SCRAPER_WAIT_UNTIL=domcontentloaded
SCRAPER_VISIBLE_TEXT_MAX_CHARS=2000

